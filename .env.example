# Copy to .env and adjust. No real secrets belong in this file.

# The only implemented synchronization strategy: asynchronous queued
# dual-write (PostgreSQL -> Outbox -> RabbitMQ -> Spring AMQP listener ->
# Elasticsearch). Any other value is rejected at startup.
ORDER_SYNC_STRATEGY=dual_write

# --- docker compose services (default port mapping) -------------------------
# PG_DSN=postgresql://ecommerce:ecommerce@127.0.0.1:5432/ecommerce
# MONGO_DSN=mongodb://127.0.0.1:27017
# ES_URL=http://127.0.0.1:9200
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672//

# --- native local stack (no Docker) ----------------------------------------
# PostgreSQL 16 uses 55432 because a system PostgreSQL already owns 5432.
PG_DSN=postgresql://ecommerce:ecommerce@127.0.0.1:55432/ecommerce
MONGO_DSN=mongodb://127.0.0.1:27017
MONGO_DB_NAME=ecommerce
ES_URL=http://127.0.0.1:9200
ES_ORDERS_INDEX=orders
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672//

# --- http ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000

# --- seed ------------------------------------------------------------------
# A constant anchor, never the current date, so the date-bucket invariants
# cannot expire and two runs are byte-reproducible.
SEED_ANCHOR_DATE=2026-09-30T00:00:00Z
SEED_DEFAULT=42
